# ==========================================
# PRISON ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# --- GitHub Webhook Integration ---
# Used to verify incoming webhook payloads using HMAC SHA-256
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# --- GitHub Authentication ---
# Personal Access Token for the ANAKIN agent to post comments and commit patches
GITHUB_TOKEN=ghp_your_personal_access_token_here

# --- GitHub App Authentication (Enterprise / Private Repos) ---
# Short-lived Installation Access Tokens are passed per-webhook (MODULE 1)
# These are NOT stored — they are used once for cloning and then revoked.
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/your/private-key.pem
GITHUB_APP_INSTALLATION_ID=your_installation_id_here

# --- AI Security Agent (ANAKIN Track) ---
# PRIORITY ORDER: DeepSeek > OpenAI > Anthropic > rule-based fallback

# DeepSeek (PRIMARY — deepseek-coder for patches, deepseek-chat for triage)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# OpenAI (Fallback 1)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Claude (Fallback 2)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# --- Core Dependencies ---
# PostgreSQL connection string for the backend orchestrator & telemetry
DATABASE_URL=postgresql://prison:prison_secure_pass_2026@localhost:5432/prison

# Redis connection string for queuing and event stream
REDIS_URL=redis://localhost:6379/0

# --- Decoy Credentials (MANTITUP Track) ---
# Synthetic honeypots injected into microVMs to trap malicious actors
HONEYPOT_AWS_KEY=AKIA_PRISON_DECOY_9982
HONEYPOT_JWT_SECRET=ey_prison_decoy_jwt_token_production_fake

# --- Semgrep Fallback (MODULE 2) ---
# Mode: AUTO (auto-detect Semgrep CLI), FORCE_DYNAMIC, FORCE_STATIC
PRISON_EXECUTION_MODE=AUTO
SEMGREP_EXTRA_CONFIGS=p/secrets,p/owasp-top-ten

# --- Frontend Dashboard ---
# API URL for the Next.js frontend to communicate with the Orchestrator
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8001

# --- Privacy & Retention ---

# PURGED = zero-retention (default). RETAIN_EVENTS_ONLY = keep normalized events only.
PRISON_DATA_RETENTION_POLICY=PURGED

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

